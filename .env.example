# =======================================================
# ORACLE DATABASE CONNECTION SETTINGS
# Attendance Management System
# =======================================================

# Database credentials
ORACLE_USER=system
ORACLE_PASSWORD=your_oracle_password
ORACLE_DSN=localhost:1521/XEPDB1

# Examples for ORACLE_DSN:
# Local Oracle XE:       localhost:1521/XE  or  localhost:1521/XEPDB1
# Local Oracle 19c/21c:  localhost:1521/orcl  or  localhost:1521/orclpdb
# Oracle Cloud Free:     db20240101_high (use with wallet)

# Optional Oracle client configuration directory (for Oracle Wallet / TNS_ADMIN):
# ORACLE_CONFIG_DIR=C:/oracle/wallet

# FastAPI Application Settings
APP_HOST=127.0.0.1
APP_PORT=8000
